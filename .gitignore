# Course exports and generated content. These are large, and they are the
# course's data rather than this tool's source.
*.tar.gz
Organized_Course_Content/

# Pipeline state. Regenerated on every run, and current_sources.json holds the
# notebook's real source titles - the user's data, not this repository's.
current_sources.json
course_structure.json
processing_manifest.json
comparison_review.json
upload_results.json

# Transcripts: course content, whether exported from Teams or produced locally.
transcripts/

# Extra material added to module PDFs from outside the export.
extra_material/

# Diagnostics, which also capture real source titles.
export_sources_debug.json
export_sources_debug.txt
panel_dump.json
upload_verify_debug.json
tar_contents.txt

# Media produced by organize_content.py.
*.mp3
*.mp4

# Python.
__pycache__/
*.py[cod]
.venv/
venv/
